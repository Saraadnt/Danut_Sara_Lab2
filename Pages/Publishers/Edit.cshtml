@page
@model Danut_Sara_Lab2.Pages.Publishers.EditModel

@{
    ViewData["Title"] = "Edit Publisher";
}

<h1>Edit Publisher</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <input type="hidden" asp-for="Publisher.ID" />

            <div class="form-group">
                <label asp-for="Publisher.PublisherName"
                       class="control-label"></label>

                <input asp-for="Publisher.PublisherName"
                       class="form-control" />

                <span asp-validation-for="Publisher.PublisherName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit"
                       value="Save"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
